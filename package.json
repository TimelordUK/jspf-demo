{
  "name": "jspf-demo",
  "version": "1.15.0",
  "description": "",
  "main": "dist/trade_capture/app.js",
  "homepage": "https://github.com/TimelordUK/jspf-demo",
  "bugs": {
    "url": "https://github.com/TimelordUK/jspf-demo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TimelordUK/jspf-demo.git"
  },
  "scripts": {
    "build": "tsc",
    "use:local": "npm install \"../.local-packages/jspurefix-local.tgz\"",
    "use:npm": "npm install jspurefix@latest",
    "tcp-tc": "node dist/trade_capture/app.js",
    "server": "node dist/trade_capture/app.js --server",
    "client": "node dist/trade_capture/app.js --client",
    "recovery": "node dist/trade_capture/app.js recovery",
    "recovery:server": "node dist/trade_capture/app.js recovery --server",
    "recovery:client": "node dist/trade_capture/app.js recovery --client",
    "broker-reset": "node dist/trade_capture/app.js broker-reset",
    "multi-client": "node dist/trade_capture/app.js multi-client --clients 3",
    "dynamic": "node dist/trade_capture/app.js dynamic",
    "custom-logon": "node dist/trade_capture/app.js custom-logon",
    "skeleton": "node dist/trade_capture/app.js skeleton",
    "skeleton:clients": "node dist/trade_capture/app.js skeleton --clients 2",
    "skeleton:server": "node dist/trade_capture/app.js skeleton --server",
    "skeleton:client": "node dist/trade_capture/app.js skeleton --client",
    "resilient": "node dist/trade_capture/app.js skeleton --client --resilient --retry-every 3",
    "resilient:recover": "node dist/trade_capture/app.js skeleton --resilient --retry-every 3 --drop-after 6 --timeout 25",
    "clear": "node dist/trade_capture/app.js clear",
    "scenarios": "bash scripts/test-scenarios.sh",
    "test": "echo \"Error: no test specified\" && exit 1",
    "parse-client-objects": "node node_modules/jspurefix/dist/jsfix-cmd --fix=../../jsfix.test_client.txt --delimiter=\"|\"  --session=../../data/session/test-initiator.json --objects",
    "parse-client-trade-captures": "node node_modules/jspurefix/dist/jsfix-cmd --fix=../../jsfix.test_client.txt --delimiter=\"|\"  --session=../../data/session/test-initiator.json --type=AE --objects",
    "parse-client-tokens": "node node_modules/jspurefix/dist/jsfix-cmd --fix=../../jsfix.test_client.txt --delimiter=\"|\"  --session=../../data/session/test-initiator.json --tokens",
    "parse-client-stats": "node node_modules/jspurefix/dist/jsfix-cmd --fix=../../jsfix.test_client.txt --delimiter=\"|\"  --session=../../data/session/test-initiator.json --tokens",
    "security-alerts": "gh api repos/{owner}/{repo}/dependabot/alerts --jq '.[] | select(.state==\"open\") | \"\\(.number) \\(.dependency.package.name) \\(.security_advisory.severity)\"'"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "commander": "^15.0.0",
    "jspurefix": "^5.11.1",
    "reflect-metadata": "^0.2.2"
  },
  "overrides": {
    "typescript": "$typescript"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
    "@types/sax": "^1.2.7",
    "eslint": "^9.39.4",
    "eslint-config-love": "^151.0.0",
    "madge": "^8.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}
